--- /dev/null
+++ b/src/dusk/reference_render_trace.h
@@ -0,0 +1,194 @@
+#pragma once
+
+#include <stdint.h>
+
+#include "dusk/logging.h"
+
+class J3DDrawBuffer;
+class J3DModel;
+class J3DShapePacket;
+
+namespace dusk::reference_render_trace {
+
+constexpr uint32_t kFrameLimit = 4;
+constexpr uint32_t kShapeCapacity = 8192;
+constexpr uint32_t kBufferCapacity = 128;
+
+struct ShapeOwner {
+    const J3DShapePacket* shape;
+    uint32_t actor_id;
+    uint16_t profile;
+    uint16_t model_id;
+};
+
+struct ModelIdentity {
+    const J3DModel* model;
+    uint16_t id;
+};
+
+inline ShapeOwner shape_owners[kShapeCapacity];
+inline ModelIdentity models[kShapeCapacity];
+inline const J3DDrawBuffer* buffers[kBufferCapacity];
+inline uint32_t frame_number;
+inline uint32_t captured_frames;
+inline uint32_t shape_count;
+inline uint32_t model_count;
+inline uint32_t frame_shape_bindings;
+inline uint32_t submission_count;
+inline uint32_t buffer_count;
+inline uint32_t current_actor_id;
+inline uint16_t current_profile;
+inline uint16_t current_buffer_id;
+inline bool active;
+inline bool capture_started;
+inline bool frame_open;
+
+inline uint16_t buffer_id(const J3DDrawBuffer* buffer) {
+    for (uint16_t index = 0; index < buffer_count; ++index) {
+        if (buffers[index] == buffer) {
+            return index;
+        }
+    }
+    if (buffer_count >= kBufferCapacity) {
+        return UINT16_MAX;
+    }
+    buffers[buffer_count] = buffer;
+    return buffer_count++;
+}
+
+inline const ShapeOwner* owner_for(const J3DShapePacket* shape) {
+    for (uint32_t index = 0; index < shape_count; ++index) {
+        if (shape_owners[index].shape == shape) {
+            return &shape_owners[index];
+        }
+    }
+    return nullptr;
+}
+
+inline uint16_t model_id(const J3DModel* model) {
+    for (uint32_t index = 0; index < model_count; ++index) {
+        if (models[index].model == model) {
+            return models[index].id;
+        }
+    }
+    if (model == nullptr || model_count >= kShapeCapacity ||
+        model_count >= UINT16_MAX) {
+        return UINT16_MAX;
+    }
+    const uint16_t id = static_cast<uint16_t>(model_count);
+    models[model_count++] = {model, id};
+    return id;
+}
+
+inline uint32_t next_submission_id() {
+    return submission_count++;
+}
+
+inline void frame_begin() {
+    if (frame_open) {
+        return;
+    }
+    frame_open = true;
+    active = capture_started && captured_frames < kFrameLimit;
+    buffer_count = 0;
+    frame_shape_bindings = 0;
+    submission_count = 0;
+    current_actor_id = UINT32_MAX;
+    current_profile = UINT16_MAX;
+    current_buffer_id = UINT16_MAX;
+    if (active) {
+        DuskLog.info(
+            "[REFTRACE] {{\"schema\":\"dusklight.desktop.render.v1\","
+            "\"type\":\"render_frame_begin\",\"frame\":{}}}",
+            frame_number);
+    }
+}
+
+inline void frame_end() {
+    if (!frame_open) {
+        return;
+    }
+    if (active) {
+        DuskLog.info(
+            "[REFTRACE] {{\"schema\":\"dusklight.desktop.render.v1\","
+            "\"type\":\"render_frame_end\",\"frame\":{},"
+            "\"shape_bindings\":{},\"buffers\":{}}}",
+            frame_number, frame_shape_bindings, buffer_count);
+        ++captured_frames;
+    }
+    ++frame_number;
+    active = false;
+    frame_open = false;
+}
+
+inline void actor_begin(uint32_t actor_id, uint16_t profile) {
+    current_actor_id = actor_id;
+    current_profile = profile;
+}
+
+inline void actor_end() {
+    current_actor_id = UINT32_MAX;
+    current_profile = UINT16_MAX;
+}
+
+inline void bind_shape(const J3DShapePacket* shape, const J3DModel* model) {
+    if (shape == nullptr || captured_frames >= kFrameLimit ||
+        frame_shape_bindings >= kShapeCapacity) {
+        return;
+    }
+    ++frame_shape_bindings;
+    if (!capture_started) {
+        capture_started = true;
+        active = true;
+        frame_open = true;
+        DuskLog.info(
+            "[REFTRACE] {{\"schema\":\"dusklight.desktop.render.v1\","
+            "\"type\":\"render_frame_begin\",\"frame\":{}}}",
+            frame_number);
+    }
+    for (uint32_t index = 0; index < shape_count; ++index) {
+        if (shape_owners[index].shape == shape) {
+            shape_owners[index].actor_id = current_actor_id;
+            shape_owners[index].profile = current_profile;
+            shape_owners[index].model_id = model_id(model);
+            return;
+        }
+    }
+    if (shape_count < kShapeCapacity) {
+        shape_owners[shape_count++] = {
+            shape, current_actor_id, current_profile, model_id(model)};
+    }
+}
+
+inline void buffer_begin(const J3DDrawBuffer* buffer) {
+    if (!active) {
+        return;
+    }
+    current_buffer_id = buffer_id(buffer);
+    DuskLog.info(
+        "[REFTRACE] {{\"schema\":\"dusklight.desktop.render.v1\","
+        "\"type\":\"render_pass_begin\",\"frame\":{},\"pass_id\":{}}}",
+        frame_number, current_buffer_id);
+    DuskLog.info(
+        "[REFTRACE] {{\"schema\":\"dusklight.desktop.render.v1\","
+        "\"type\":\"render_bucket_begin\",\"frame\":{},\"bucket_id\":{}}}",
+        frame_number, current_buffer_id);
+}
+
+inline void buffer_end(const J3DDrawBuffer* buffer) {
+    if (!active) {
+        return;
+    }
+    const uint16_t id = buffer_id(buffer);
+    DuskLog.info(
+        "[REFTRACE] {{\"schema\":\"dusklight.desktop.render.v1\","
+        "\"type\":\"render_bucket_end\",\"frame\":{},\"bucket_id\":{}}}",
+        frame_number, id);
+    DuskLog.info(
+        "[REFTRACE] {{\"schema\":\"dusklight.desktop.render.v1\","
+        "\"type\":\"render_pass_end\",\"frame\":{},\"pass_id\":{}}}",
+        frame_number, id);
+    current_buffer_id = UINT16_MAX;
+}
