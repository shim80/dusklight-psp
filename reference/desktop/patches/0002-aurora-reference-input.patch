+PADButton reference_button_for_read(const uint64_t read, const char** name) {
+  const char* cursor = std::getenv("DUSKLIGHT_REFERENCE_INPUT");
+  if (cursor == nullptr) {
+    return 0;
+  }
+
+  while (*cursor != '\0') {
+    char* frameEnd = nullptr;
+    const unsigned long long frame = std::strtoull(cursor, &frameEnd, 10);
+    if (frameEnd == cursor || *frameEnd != ':') {
+      return 0;
+    }
+
+    const char* buttonBegin = frameEnd + 1;
+    const char* buttonEnd = buttonBegin;
+    while (*buttonEnd != '\0' && *buttonEnd != ',') {
+      ++buttonEnd;
+    }
+    const std::string_view buttonName{
+        buttonBegin, static_cast<size_t>(buttonEnd - buttonBegin)};
+    PADButton button = 0;
+    if (buttonName == "START") {
+      button = PAD_BUTTON_START;
+      *name = "START";
+    } else if (buttonName == "A") {
+      button = PAD_BUTTON_A;
+      *name = "A";
+    } else if (buttonName == "B") {
+      button = PAD_BUTTON_B;
+      *name = "B";
+    } else if (buttonName == "UP") {
+      button = PAD_BUTTON_UP;
+      *name = "UP";
+    } else if (buttonName == "DOWN") {
+      button = PAD_BUTTON_DOWN;
+      *name = "DOWN";
+    } else if (buttonName == "LEFT") {
+      button = PAD_BUTTON_LEFT;
+      *name = "LEFT";
+    } else if (buttonName == "RIGHT") {
+      button = PAD_BUTTON_RIGHT;
+      *name = "RIGHT";
+    } else {
+      return 0;
+    }
+
+    if (frame == read) {
+      return button;
+    }
+    cursor = *buttonEnd == ',' ? buttonEnd + 1 : buttonEnd;
+  }
+  return 0;
+}
+#endif
