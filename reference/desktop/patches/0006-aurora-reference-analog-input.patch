+struct ReferenceAnalog {
+  s8 x;
+  s8 y;
+  bool active;
+};
+
+ReferenceAnalog reference_analog_for_read(const uint64_t read) {
+  const char* cursor = std::getenv("DUSKLIGHT_REFERENCE_ANALOG");
+  if (cursor == nullptr) {
+    return {};
+  }
+
+  while (*cursor != '\0') {
+    char* startEnd = nullptr;
+    const unsigned long long start = std::strtoull(cursor, &startEnd, 10);
+    if (startEnd == cursor || *startEnd != '-') {
+      return {};
+    }
+    char* endEnd = nullptr;
+    const unsigned long long end =
+        std::strtoull(startEnd + 1, &endEnd, 10);
+    if (endEnd == startEnd + 1 || *endEnd != ':') {
+      return {};
+    }
+    char* xEnd = nullptr;
+    const long x = std::strtol(endEnd + 1, &xEnd, 10);
+    if (xEnd == endEnd + 1 || *xEnd != ':') {
+      return {};
+    }
+    char* yEnd = nullptr;
+    const long y = std::strtol(xEnd + 1, &yEnd, 10);
+    if (yEnd == xEnd + 1 ||
+        (*yEnd != '\0' && *yEnd != ',') ||
+        start > end || x < -127 || x > 127 || y < -127 || y > 127) {
+      return {};
+    }
+    if (read >= start && read <= end) {
+      return {
+          static_cast<s8>(x), static_cast<s8>(y), true};
+    }
+    cursor = *yEnd == ',' ? yEnd + 1 : yEnd;
+  }
+  return {};
+}

